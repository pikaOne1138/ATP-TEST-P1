---
import {getCollection,render} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Page from '../../components/layouts/expanded/Page.astro';
export async function getStaticPaths(){const entries=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt-a.data.publishedAt);return entries.map((entry,i)=>({params:{slug:entry.id},props:{entry,previous:entries[i+1],next:entries[i-1]}}));}
const {entry,previous,next}=Astro.props;const {Content}=await render(entry);const base=import.meta.env.BASE_URL;
---
<SiteLayout title={entry.data.title} description={entry.data.description}><Page route={'articles/'+entry.id} entry={entry}><Content/><nav aria-label="其他文章">{previous&&<a href={base+'articles/'+previous.id+'/'}>← {previous.data.title}</a>}{next&&<a href={base+'articles/'+next.id+'/'}>{next.data.title} →</a>}</nav></Page></SiteLayout>
