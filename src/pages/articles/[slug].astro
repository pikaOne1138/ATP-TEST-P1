---
import {getCollection,render} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Page from '../../components/layouts/expanded/Page.astro';
export async function getStaticPaths(){const entries=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt-a.data.publishedAt);return entries.map((entry,i)=>({params:{slug:entry.id},props:{entry,previous:entries[i+1],next:entries[i-1]}}));}
const {entry,previous,next}=Astro.props;const all=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt-a.data.publishedAt);const sameTag=all.filter(x=>x.id!==entry.id&&x.data.tags.some(t=>entry.data.tags.includes(t))).slice(0,3);const related=sameTag.length?sameTag:all.filter(x=>x.id!==entry.id).slice(0,3);const relatedTitle=sameTag.length?'相關文章':'其他文章';const {Content}=await render(entry);const base=import.meta.env.BASE_URL;
---
<SiteLayout title={entry.data.title} description={entry.data.description}><Page route={'articles/'+entry.id} entry={entry}><Content/>{related.length>0&&<aside class="related" aria-label={relatedTitle}><h2>{relatedTitle}</h2><ul>{related.map(x=><li><a href={base+'articles/'+x.id+'/'}>{x.data.title}</a><span>{x.data.tags.join('、')}</span></li>)}</ul></aside>}</Page></SiteLayout>
<style is:global>
.related{margin-top:64px;padding-top:24px;border-top:1px solid color-mix(in srgb,var(--color-content) 30%,var(--color-surface))}
.related h2{font:400 24px var(--font-heading);margin:0 0 8px}
.related ul{list-style:none;margin:0;padding:0}
.related li{display:flex;flex-wrap:wrap;gap:4px 16px;align-items:baseline;padding:8px 0}
.related li a{text-decoration:underline;text-underline-offset:5px;min-height:44px;display:inline-flex;align-items:center}
.related li span{font-size:15px;opacity:.75}
.pager{display:flex;flex-wrap:wrap;gap:8px 32px;justify-content:space-between;margin-top:48px}
.pager a{min-height:44px;display:inline-flex;align-items:center;text-decoration:underline;text-underline-offset:5px}
</style>
