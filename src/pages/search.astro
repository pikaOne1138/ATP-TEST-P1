---
import Page from '../components/layouts/expanded/Page.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
const base=import.meta.env.BASE_URL;
---
<SiteLayout title="搜尋" searchable={false}><Page route="extra" extra={true}><section class="interior"><h1>搜尋</h1><p>輸入關鍵字，找這裡的文章。</p><link rel="stylesheet" href={base+'pagefind/pagefind-ui.css'}/><div id="search"></div><noscript>搜尋功能需要開啟瀏覽器的 JavaScript；你也可以從「文章」頁瀏覽全部內容。</noscript></section><script is:inline src={base+'pagefind/pagefind-ui.js'}></script><script is:inline define:vars={{base}}>window.addEventListener('DOMContentLoaded',()=>{new PagefindUI({element:'#search',bundlePath:base+'pagefind/',showSubResults:false,showImages:false,translations:{placeholder:'輸入關鍵字',clear_search:'清除',load_more:'顯示更多結果',search_label:'搜尋這個網站',filters_label:'篩選',zero_results:'找不到和「[SEARCH_TERM]」有關的內容，換個詞試試看。',many_results:'找到 [COUNT] 筆和「[SEARCH_TERM]」有關的結果',one_result:'找到 [COUNT] 筆和「[SEARCH_TERM]」有關的結果',alt_search:'找不到「[SEARCH_TERM]」，改為顯示「[DIFFERENT_TERM]」的結果',search_suggestion:'找不到「[SEARCH_TERM]」，可以試試這些：',searching:'正在找「[SEARCH_TERM]」…'}});});</script></Page></SiteLayout>
<style is:global>
#search{--pagefind-ui-scale:1;--pagefind-ui-primary:var(--color-primary);--pagefind-ui-text:var(--color-content);--pagefind-ui-background:var(--color-surface);--pagefind-ui-border:color-mix(in srgb,var(--color-content) 30%,var(--color-surface));--pagefind-ui-tag:color-mix(in srgb,var(--color-primary) 10%,var(--color-surface));--pagefind-ui-border-width:1px;--pagefind-ui-border-radius:6px;--pagefind-ui-font:var(--font-body);margin-top:24px}
#search .pagefind-ui__search-clear{font-size:16px;min-height:44px}
#search .pagefind-ui__message{font-size:16px;font-weight:400;height:auto;padding:16px 0}
#search .pagefind-ui__result-title{font-size:20px}
#search .pagefind-ui__result-excerpt{font-size:17px;line-height:1.8}
#search mark{background:color-mix(in srgb,var(--color-primary) 22%,var(--color-surface));color:inherit}
</style>
