---
import config from '../../../../site.config.json';
import ContentPatterns from '../../ContentPatterns.astro';
import SelectedPatterns from '../../SelectedPatterns.astro';
import StudentNavigation from '../../StudentNavigation.astro';
import OwnerImage from '../../OwnerImage.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'||(route===''&&site.kind==='knowledge')?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="sidebar-journal" class="journal">
  <div class="frame">
    <aside class="rail" aria-label="網站側欄" data-pagefind-ignore>
      <a class="brand" href={base}><OwnerImage role="logo"/></a>
      <p class="rail-intro">{site.intro}</p>
      <StudentNavigation/>
      {site.hasBio&&route!=='about'&&<div class="rail-bottom"><p>{site.bio}</p><a href={base+'about/'}>關於我 →</a></div>}
    </aside>
    <div class="body">
      
      {route==='' && <>
        <h1 class="sr-only">{site.headline}</h1>{route===''&&<ContentPatterns position="after-intro"/>}
        {site.copy.greeting&&<p class="hello">{site.copy.greeting}</p>}<section class="desk"><div class="desk-label"><h2>{site.headings?.['h2-01']??<Fragment>最近的三則</Fragment>}</h2><p>{site.copy.p4??(route==='about'?site.aboutFields[3]:'')}</p></div><div class="entries">{articles.length===0&&<p class="archive-empty">目前還沒有文章。</p>}{articles.map(a=><article class="entry"><div class="meta"><span class="no">{a.no}</span><time datetime={a.date}>{a.dateText}</time>{a.tags.length>0&&<> ・ <span class="tag">{a.tags.join("、")}</span></>}</div><h3>{a.href?<a href={a.href}>{a.title}</a>:a.title}</h3><p>{a.summary}</p></article>)}</div>{articles.length>0&&<a class="line-link" data-primary-cta="home" href={site.primaryCta.href}>看全部文章 →</a>}</section>
        {site.hasBio&&<section class="signature"><p>{site.bio}</p><a class="line-link" href={base+'about/'}>關於我 →</a></section>}
      </>}
      {route==='articles' && <><section class="pagehead">{articles.length>0&&<p class="eyebrow">共 {articles.length} 篇</p>}<h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.copy.p6??(route==='about'?site.aboutFields[1]:'')}</p></section><div class="archive">{articles.map(a=><article><span class="meta"><span class="no">{a.no}</span><time datetime={a.date}>{a.dateText}</time>{a.tags.length>0&&<span class="tag">{a.tags.join("、")}</span>}</span><div><h2>{a.href?<a href={a.href}>{a.title}</a>:a.title}</h2><p>{a.summary}</p></div></article>)}</div></>}
      {(route??'').startsWith('articles/') && <><article class="reading"><p class="eyebrow" data-pagefind-ignore>{detailRecord?.date&&<time datetime={detailRecord.date}>{detailRecord.dateText}</time>}{detailRecord?.tags?.length>0&&<> ・ <span class="tag">{detailRecord.tags.join("、")}</span></>}</p><h1>{detailRecord?.title??'目前沒有公開文章'}</h1><p class="lead">{route==='about'?site.bio:route===''?site.intro:detailRecord?.summary??site.intro}</p><div class="prose">{route==='about'?<><p>{site.bio}</p>{site.aboutFields.map(p=><p>{p}</p>)}</>:<slot/>}</div><a class="line-link" data-pagefind-ignore href={base+'articles/'}>← 回文章列表</a></article></>}
      {route==='about' && <><section class="pagehead"><h1>關於我</h1>{site.hasBio&&<p>{site.bio}</p>}</section><section class={config.brand.heroImagePath?'about-grid':'about-grid about-grid--text'}>{config.brand.heroImagePath&&<div class="initial native-image-slot"><OwnerImage fill/></div>}<div>{site.aboutFields[0]&&<><h2>{site.headings?.['h2-02']??<Fragment>寫作從哪裡開始？</Fragment>}</h2><p>{site.aboutFields[0]}</p></>}{site.aboutFields[1]&&<><h2>{site.headings?.['h2-03']??<Fragment>如何持續整理？</Fragment>}</h2><p>{site.aboutFields[1]}</p></>}{site.aboutFields[2]&&<><h2>{site.headings?.['h2-04']??<Fragment>背景與來源</Fragment>}</h2><p>{site.aboutFields[2]}</p></>}<a class="line-link" href={base+'articles/'}>讀文章 →</a></div></section></>}
      {route.startsWith('services/')&&detailRecord?.bookingUrl&&<p class="native-booking"><a href={detailRecord.bookingUrl} rel="noopener noreferrer">前往正式預約頁 ↗</a></p>}{extra&&<section class="native-extra"><slot/></section>}{route==='articles'&&site.articles.length===0&&<p class="archive-empty">目前還沒有文章。</p>}{route==='services'&&site.services.length===0&&<section class="native-unconfigured"><p>尚未提供正式服務。</p><dl>{[['服務範圍',config.serviceFacts?.scope],['服務方式',config.serviceFacts?.method],['服務時間',config.serviceFacts?.duration],['實際費用',config.serviceFacts?.price],['資格與來源',config.serviceFacts?.qualification],['取消政策',config.serviceFacts?.cancellation]].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}<ContentPatterns/>{config.sectionPatterns?.some(p=>p.patternId.startsWith('footer-'))?<SelectedPatterns page="site-wide"/>:<footer data-pagefind-ignore><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>}
    </div>
  </div>
</div>

<style>
.journal{--j-ink:var(--color-content);--j-muted:color-mix(in srgb,var(--color-content) 70%,var(--color-surface));--j-rule:color-mix(in srgb,var(--color-content) 30%,var(--color-surface));background:var(--color-surface);color:var(--j-ink);font-family:var(--font-body);font-size:18px;line-height:1.85;min-height:100vh}.journal a{color:inherit;text-decoration:none}.journal a:hover{text-decoration:underline;text-underline-offset:5px}.frame{max-width:1360px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 280px;min-height:100vh}.frame::before{content:"";grid-column:2;grid-row:1;border-left:1px solid var(--color-primary);pointer-events:none}.rail{grid-column:2;grid-row:1;border-left:1px solid transparent;padding:48px 32px;position:sticky;top:0;align-self:start;max-height:100vh;overflow-y:auto;display:flex;flex-direction:column}.brand{font-size:24px;font-weight:700;line-height:1.4;color:var(--color-primary)}.journal a.brand{color:var(--color-primary)}.brand span{display:block;font:12px var(--font-mono);letter-spacing:.08em;margin-top:8px}.rail-intro{font-size:17px;max-width:20ch;margin:40px 0 0}.rail nav{display:grid}.rail :global(.student-nav-wrap){display:block}@media(min-width:701px){.rail :global(.student-navigation__cta){display:none}.rail :global(.student-navigation){display:grid;grid-template-columns:1fr;gap:0;margin-top:40px}.rail :global(.student-navigation>a){border-top:1px solid var(--j-rule);border-radius:0;padding:14px 0;min-height:56px;font-size:18px}.rail :global(.student-navigation>a[aria-current]){font-weight:700;color:var(--color-primary)}}.rail :global(.student-nav-toggle){font-size:16px}.rail nav a{border-top:1px solid var(--j-rule);padding:16px 0;display:flex;gap:24px;font:18px var(--font-body);min-height:56px}.rail nav a span{font:18px var(--font-body)}.rail nav a[aria-current]{font-weight:700}.rail-bottom{margin-top:40px;padding-top:24px;border-top:1px solid var(--j-rule);font-size:16px;line-height:1.85}.rail-bottom p{margin:0 0 8px}.rail-bottom a{color:var(--color-primary);text-decoration:underline;text-underline-offset:5px}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}.rail-bottom strong,.eyebrow,.meta,.top{font:15px/1.7 var(--font-body);letter-spacing:.02em}.rail-bottom a{display:inline-flex;min-height:44px;align-items:center}.body{grid-column:1;grid-row:1;min-width:0;padding:0 64px}.top{padding:24px 0;border-bottom:1px solid var(--j-rule);display:flex;justify-content:space-between;gap:24px}.intro{padding:32px 0 24px;max-width:800px;border-bottom:1px solid var(--j-rule)}.eyebrow,.meta{color:var(--j-muted)}.meta time,.eyebrow time{white-space:nowrap}.tag{color:var(--color-primary)}.archive .meta{display:flex;flex-direction:column}h1,h2,h3,p{overflow-wrap:anywhere}h1{font:400 clamp(30px,3.4vw,46px)/1.3 var(--font-heading);letter-spacing:-.01em;text-wrap:balance;margin:32px 0} .intro h1{font-size:clamp(30px,3vw,46px);margin:12px 0}h1 em{display:block;font-style:normal;color:var(--color-primary)}.lead{font-size:20px;max-width:34ch}.archive-empty{font-size:18px;color:var(--j-muted);padding:8px 0 64px}.line-link{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid currentColor;margin-top:24px}.journal a.line-link{color:var(--color-primary)}.journal .entry h3 a:hover,.journal .archive h2 a:hover{color:var(--color-primary)}.prose :global(a){color:var(--color-primary);text-decoration:underline;text-underline-offset:5px}.desk{display:block;padding:48px 0 48px}.desk-label{border-top:3px solid var(--color-primary);padding-top:16px}.desk-label{display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap}.desk-label h2{font-size:22px}.desk-label p{max-width:40ch}.desk-label h2{font:400 32px var(--font-heading)}.desk-label p{max-width:25ch}.entry{padding:24px 0 32px;border-bottom:1px solid var(--j-rule)}.entry:first-child{padding-top:0}.entry h3{font:400 clamp(24px,3vw,36px)/1.3 var(--font-heading);margin:16px 0}.entry p{max-width:52ch}.entry small,.archive small{color:var(--j-muted)}.signature{background:color-mix(in srgb,var(--color-primary) 10%,var(--color-surface));padding:48px;margin-bottom:96px}@media(min-width:701px){.signature{display:none}}.signature>p{font-size:19px;line-height:1.95;max-width:38em;margin:0}.pagehead{padding:56px 0 32px;max-width:760px}.pagehead>p:last-child{font-size:19px;line-height:1.95;max-width:38em}.archive article{display:grid;grid-template-columns:140px minmax(0,1fr);gap:32px;padding:32px 0;border-top:1px solid var(--j-rule)}.archive h2{font:400 clamp(24px,3vw,36px) var(--font-heading);margin:0}.archive p{max-width:60ch}.reading{padding:80px 0 96px;max-width:780px}.reading h1{font-size:clamp(28px,3.4vw,44px)}.prose{max-width:38em;margin:48px 0;font-size:19px;line-height:1.95}.prose h2{font:400 32px var(--font-heading);margin-top:64px}.prose blockquote{margin:48px 0;border-left:2px solid var(--color-primary);padding-left:24px;font:italic 24px/1.7 var(--font-heading)}.about-grid{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding:32px 0 96px}.initial{background:color-mix(in srgb,var(--color-primary) 10%,var(--color-surface));min-height:320px;display:grid;place-content:center;text-align:center;color:var(--j-muted)}.about-grid h2{font:400 32px var(--font-heading)}.about-grid p{max-width:38em}.about-grid--text{display:block;padding-top:0}.body footer{border-top:1px solid var(--j-rule);padding:32px 0 64px;display:flex;gap:24px;flex-wrap:wrap;justify-content:space-between;font-size:16px}.journal{--j-hand:"Zen Kurenaido","Iansui","Kaiti TC","BiauKai","DFKai-SB",var(--font-heading)}.hello{font-family:var(--j-hand);font-size:clamp(36px,4vw,46px);line-height:1.4;color:color-mix(in srgb,var(--color-primary) 75%,var(--color-content));margin:44px 0 0;transform:rotate(-1.5deg);transform-origin:left center}.hello+.desk{padding-top:28px}.no{font:400 20px/1.3 var(--font-heading);color:var(--color-primary);letter-spacing:.04em}.entry .no{margin-right:14px}.rail :global(.student-nav-toggle),.rail :global(.student-navigation__cta){display:none}@media(min-width:701px){.journal .rail :global(.student-nav-wrap.is-enhanced:not(.is-open)>.student-navigation){display:grid}}@media(max-width:980px){.frame{grid-template-columns:minmax(0,1fr) 220px}.rail{padding:32px 24px}.body{padding:0 32px}.desk{gap:24px}}@media(max-width:700px){.frame{display:block}.frame::before{display:none}.rail{grid-column:auto;grid-row:auto;position:static;max-height:none;overflow:visible;border-left:0;border-bottom:1px solid var(--j-ink);padding:24px 20px}.rail-bottom{display:none}.rail-intro{margin:8px 0 0;max-width:none;font-size:16px}.rail nav{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px}.rail nav a{border:0;padding:0;min-height:44px}.rail nav a span{font-size:16px}.body{grid-column:auto;grid-row:auto;padding:0 20px}.top{padding:16px 0;flex-wrap:wrap}.intro{padding:40px 0 40px}.desk{display:block;padding:32px 0 48px}.desk-label{margin-bottom:40px}.signature{margin:0 0 64px;padding:24px}.pagehead,.reading{padding:48px 0}.archive article{grid-template-columns:minmax(0,1fr);gap:8px}.archive .meta{flex-direction:row;gap:16px}.about-grid{display:block}.initial{min-height:200px;margin-bottom:32px}.prose{font-size:18px}.hello{margin-top:28px}.hello+.desk{padding-top:24px}.entry .no{margin-right:12px;font-size:17px}.archive .no{font-size:17px}.journal .rail :global(.student-nav-wrap.is-enhanced:not(.is-open)>.student-navigation),.rail :global(.student-navigation){display:flex;flex-direction:row;flex-wrap:wrap;gap:0 28px;margin-top:12px;width:100%}.rail :global(.student-navigation>a){padding:0;min-height:44px;border-radius:0;font-size:17px;text-decoration:underline;text-decoration-color:var(--j-rule);text-underline-offset:6px}.rail :global(.student-navigation>a[aria-current]){color:var(--color-primary);font-weight:700;text-decoration-color:currentColor}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 var(--font-body);padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:18px;line-height:1.8;max-width:65ch}

/* 候選 hb-collage（濃）：貼滿的手帳——點點紙底、每篇是一張貼上去的紙片（紙膠帶、圓章編號、標籤框）、問候語是便條紙 */
.journal{--j-dot:color-mix(in srgb,var(--color-content) 16%,transparent);--j-tape:color-mix(in srgb,var(--color-accent) 38%,var(--color-surface));--j-note:color-mix(in srgb,var(--color-accent) 16%,var(--color-surface))}
.body{background-image:radial-gradient(var(--j-dot) 1px,transparent 1.5px);background-size:22px 22px}
.hello{display:inline-block;position:relative;background:var(--j-note);padding:18px 28px 14px;margin-top:56px;box-shadow:var(--shadow-sm);transform:rotate(-2deg)}
.hello::before,.entry::before,.archive article::before{content:"";position:absolute;top:-12px;left:32px;width:84px;height:24px;background:var(--j-tape);opacity:.85;transform:rotate(-3deg)}
.desk-label{border-top:0;padding-top:0;margin-bottom:28px}
.entry,.archive article{position:relative;background:var(--color-surface);border:1px solid var(--j-rule);box-shadow:var(--shadow-sm);padding:36px 28px 24px;margin:0 0 36px}
.entry:first-child{padding-top:36px}
.entry:nth-child(even)::before,.archive article:nth-child(even)::before{left:auto;right:120px;transform:rotate(4deg)}
.entry .no,.entry:first-child .no,.archive .no{position:absolute;top:18px;right:22px;left:auto;margin:0;width:48px;height:48px;border:1.5px solid var(--color-primary);border-radius:var(--radius-pill);display:grid;place-items:center;font-size:18px;line-height:1;transform:rotate(8deg)}
.entry .meta,.archive .meta{padding-right:56px}
.tag{border:1px solid currentColor;border-radius:var(--radius-sm);padding:1px 8px;align-self:flex-start}
.archive{padding-top:8px}
@media(max-width:700px){.hello{margin-top:36px;padding:14px 20px 10px}.entry,.archive article{padding:32px 20px 20px;margin-bottom:32px}}
</style>
<style>.native-extra{padding:32px 0 48px;font-size:18px}.native-extra :global(h1){font:400 clamp(30px,3.4vw,46px)/1.3 var(--font-heading);letter-spacing:-.01em;margin:24px 0}.native-extra :global(.interior){padding:0;margin:0;width:auto;max-width:38em} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>.native-story-image{width:100%;max-height:640px;object-fit:cover} p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>

<style>dl>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,2fr);gap:16px;padding-block:16px}dd{margin:0}.additional-services article{padding:24px;border:1px solid var(--line);margin-block:24px;background:var(--color-surface)}@media(max-width:600px){dl>div{display:block}dt{margin-bottom:8px}}</style>

<style>.native-booking{padding:24px;max-width:1200px;margin:auto}.native-booking a{display:inline-flex;min-height:44px;align-items:center;text-decoration:underline}</style>

<style>.native-image-slot{position:relative;overflow:hidden}</style>
