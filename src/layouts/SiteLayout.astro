---
import config from '../../site.config.json';
import OwnerImage from '../components/OwnerImage.astro';
import StudentNavigation from '../components/StudentNavigation.astro';
import ContentPatterns from '../components/ContentPatterns.astro';
import SelectedPatterns from '../components/SelectedPatterns.astro';
const {title,description=config.brand.tagline,searchable=true}=Astro.props;
const base=import.meta.env.BASE_URL;
const cta=config.navigation.find(x=>x.id===config.primaryCta.pageId);
const greeting=Astro.url.pathname===base?config.layoutContent?.copy?.greeting:'';
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL+'brand-mark.svg'}/><title>{title===config.brand.name?title:`${title}｜${config.brand.name}`}</title><meta name="description" content={description}/><meta name="robots" content={process.env.SITE_INDEXABLE==='true'?'index, follow':'noindex, nofollow, noarchive'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site??Astro.url).href}/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite",name:config.brand.name,url:new URL(base,Astro.site??Astro.url).href}).replace(/</g,"\u003c")}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site??Astro.url).href}/>{config.brand.typography!=='clear-sans'&&<><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400&display=swap"/></>}{greeting&&<><link rel="stylesheet" href={'https://fonts.googleapis.com/css2?family=Zen+Kurenaido&display=swap&text='+encodeURIComponent([...new Set(greeting.replace(/[^\u4e00-\u9fff]/g,''))].join(''))}/><link rel="stylesheet" href={'https://fonts.googleapis.com/css2?family=Iansui&display=swap&text='+encodeURIComponent(greeting)}/></>}<link rel="stylesheet" href={base+'tokens.css'}/><link rel="stylesheet" href={base+'theme.css'}/><link rel="stylesheet" href={base+'component-contract.css'}/><link rel="stylesheet" href={base+'site.css'}/></head><body data-long-headline={config.content.headline.length>40?'true':undefined} data-layout={config.layoutSlug} data-site-family={config.layoutSlug} data-assembled-layout={config.layoutSlug}><a class="skip" href="#main">跳到主要內容</a>{!config.nativeLayout&&<header class="site-header"><a class="site-brand" href={base}><OwnerImage role="logo"/><small>{config.kind==='knowledge'?'閱讀與內容':'服務與陪伴'}</small></a><StudentNavigation />{cta&&!config.nativeLayout&&<a class="action" href={base+cta.path}>{config.primaryCta.label}</a>}</header>}<main id="main" data-pagefind-body={searchable?true:undefined}><slot/>{!config.nativeLayout&&<div class="pattern-page-end"><ContentPatterns/></div>}</main>{!config.nativeLayout&&(config.sectionPatterns?.some(x=>x.patternId.startsWith('footer-'))?<SelectedPatterns page="site-wide"/>:<footer class="site-footer"><span>{config.brand.name}</span><nav aria-label="頁尾導覽">{config.navigation.map(x=><a href={base+x.path}>{x.label}</a>)}</nav></footer>)}</body></html>

<style>.pattern-page-end{width:min(100% - 40px,1120px);margin:auto}</style>
