{
  "name": "student-astro-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/clean-build.mjs && astro build && pagefind --site dist --root-selector \"[data-pagefind-body]\" && node scripts/build-exact-search.mjs && node scripts/verify-navigation.mjs",
    "preview": "astro preview",
    "verify": "node scripts/verify-site-output.mjs --student-site .",
    "test:regressions": "node scripts/test-generated-link-audit.mjs && node scripts/test-site-output-regressions.mjs",
    "status": "node scripts/site-status.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:context": "node scripts/check-project-context.mjs"
  },
  "dependencies": {
    "astro": "^5.14.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.0"
  }
}
