---
import config from '../../../../site.config.json';
import ContentPatterns from '../../ContentPatterns.astro';
import OwnerImage from '../../OwnerImage.astro';
const base=import.meta.env.BASE_URL,root=base;
const content=config.artDirection??{};
const allowedTargets={fit:'#fit',services:base+'services/',faq:base+'faq/'};
const fallbackIntents=[{title:'了解服務適配範圍',detail:'先核對哪些需求在服務範圍內。',target:'fit'},{title:'了解合作方式',detail:'閱讀已公開的服務說明。',target:'services'},{title:'閱讀常見問題',detail:'不必提供個人資料。',target:'faq'}];
const configured=Array.isArray(content.visitorIntents)?content.visitorIntents.filter(p=>p&&typeof p.title==='string'&&p.title.trim()&&typeof p.detail==='string'&&p.detail.trim()&&Object.hasOwn(allowedTargets,p.target)):[];
const intents=(configured.length?configured:fallbackIntents).map((p,i)=>({...p,n:String(i+1).padStart(2,'0'),href:allowedTargets[p.target],cta:p.target==='fit'?'查看範圍':p.target==='services'?'閱讀服務':'閱讀問答'}));

---
<div class="compass" data-assembled-layout="practice-compass"><div class="shell"><section class="hero"><p class="mono">先看看</p><div class="hero-grid"><div><p class="eyebrow">{config.brand.tagline}</p><h1>{config.content.headline||config.brand.name}<svg class="hand-line" viewBox="0 0 220 18" aria-hidden="true" focusable="false"><path d="M3 11 C 28 3, 46 16, 76 9 S 128 4, 152 11 S 196 14, 217 6" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"/></svg><em>{config.content.intro||'先了解，再決定下一步。'}</em></h1></div><aside>{config.brand.heroImagePath&&<OwnerImage/>}<p>先了解提供什麼、不提供什麼，再做知情選擇。</p><p class="disclaimer">服務資料以本網站已公開的資訊為準；未提供的欄位會明確標示待設定。</p><a class="button" href="#choose">從自己的問題開始 ↓</a></aside></div></section><ContentPatterns position="after-intro"/></div>
<section class="decision" id="choose"><div class="shell"><p class="mono">你現在的情況</p><h2>{config.layoutContent?.headings?.['h2-01']??<Fragment>你現在比較接近哪一種情況？</Fragment>}</h2><p>這是閱讀入口，不是診斷工具。</p>{intents.map(p=><article class="decision-row"><div class="num">{p.n}</div><div><h3>{p.title}</h3><p>{p.detail}</p></div><a href={p.href}>{p.cta} ↗</a></article>)}</div></section>
<div class="shell"><section class="fit" id="fit"><div><p class="mono">適合與否</p><h2>{config.layoutContent?.headings?.['h2-02']??<Fragment>適不適合，<em>先看清楚再選擇。</em></Fragment>}</h2></div><div class="fit-grid"><article><h3>服務適合的需求</h3>{(content.scope?.suitable??[]).length?<ul>{(content.scope?.suitable??[]).map(s=><li>{s}</li>)}</ul>:<p>這一格還在整理，之後會用我自己的話寫在這裡。</p>}</article><article><h3>不適合或需要其他支持</h3>{(content.scope?.notSuitable??[]).length?<ul>{(content.scope?.notSuitable??[]).map(s=><li>{s}</li>)}</ul>:<p>這一格還在整理。本站不能承接即時危機處理。</p>}</article></div></section><section class="information" id="information"><span class="mono">陪伴資訊</span><div><h2>{config.layoutContent?.headings?.['h2-03']??<Fragment>服務流程，應在聯絡之前看清楚。</Fragment>}</h2><p>了解範圍、資格、費用、取消規則與聯絡方式。</p></div><a href={base+'services/'}>閱讀完整服務資訊 ↗</a></section><section class="faq" id="faq"><div><p class="mono">想先問問</p><h2>{config.layoutContent?.headings?.['h2-04']??<Fragment>先問清楚，也可以。</Fragment>}</h2></div><div>{(content.faq??[]).length?(content.faq??[]).map(q=><details><summary>{q.question}</summary><p>{q.answer}</p></details>):<p>常見問題還在整理中。想先了解，可以看<a href={base+'services/'}>陪伴方式</a>。</p>}</div></section><section class="soft-invite" id="invite"><div><p class="mono">不急</p><h2>不用急著決定。</h2><p>想再多了解一點，或只是想先問一個小問題，都可以慢慢來。</p><a class="button" href={base+'contact/'}>看看聯絡方式</a></div></section></div></div>
<style>
.compass{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .37  0 0 0 0 .33  0 0 0 0 .27  0 0 0 .07 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"),var(--bg);color:var(--ink);font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.8}.shell{width:min(100% - 40px,1250px);margin:auto}.compass a{color:inherit;text-decoration:none}.compass a:hover{text-decoration:underline;text-underline-offset:5px}.compass a:focus-visible,.compass summary:focus-visible{outline:3px solid var(--brand);outline-offset:4px}.header{min-height:88px;border-bottom:1px solid var(--ink);display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-size:20px;font-weight:800}.brand small{display:block;font:12px ui-monospace,monospace}.header nav{display:flex;flex-wrap:wrap;gap:24px}.header nav a{min-height:44px;display:flex;align-items:center}.mono{font:12px ui-monospace,monospace;letter-spacing:.1em}.hero{padding:64px 0 96px}.hero-grid{display:grid;grid-template-columns:2fr 1fr;gap:64px;align-items:end}.eyebrow{color:var(--brand)}.compass h1{text-wrap:balance;font:400 clamp(44px,6.5vw,92px) Georgia,'Noto Serif TC',serif;line-height:1.18;letter-spacing:-.03em;margin:24px 0 0}.compass h1 span,.compass h1 em{display:block}.compass h1 em{color:var(--brand)}.hero aside{padding-left:32px;border-left:1px solid var(--line)}.hero aside>p:first-child{font-size:20px}.disclaimer{font-size:14px}.button{display:inline-flex;align-items:center;background:var(--brand);color:#fff!important;padding:12px 24px;min-height:48px}.soft-invite{margin:56px 0 72px;padding:40px 28px;background:color-mix(in srgb,var(--accent) 13%,var(--bg));border-top:3px solid var(--accent)}.soft-invite h2{font:400 clamp(28px,3.4vw,40px) Georgia,'Noto Serif TC',serif;margin:0 0 12px}.soft-invite p{margin:0 0 20px}.soft-invite .mono{margin-bottom:8px}.hand-line{display:block;width:min(220px,55%);height:18px;margin:6px 0 4px}.decision{background:color-mix(in srgb,var(--brand) 14%,var(--bg));color:var(--ink);padding:64px 0 80px}.decision h2,.fit h2,.faq h2{text-wrap:balance;font:400 clamp(32px,4vw,54px) Georgia,'Noto Serif TC',serif;line-height:1.25}.decision-row{display:grid;grid-template-columns:100px 1fr 210px;gap:32px;align-items:center;border-top:1px solid color-mix(in srgb,var(--ink) 22%,transparent);padding:32px 0}.decision-row:first-of-type{margin-top:48px}.num{font:36px Georgia,serif}.num small{display:block;font:12px ui-monospace,monospace}.decision-row h3{font-size:24px;font-weight:500;margin:0}.decision-row p{font-size:16px;color:color-mix(in srgb,var(--ink) 80%,var(--bg))}.decision-row>a{border:1px solid var(--brand);min-height:48px;display:flex;align-items:center;justify-content:center;padding:8px}.fit{padding:112px 0;display:grid;grid-template-columns:1fr 1.5fr;gap:48px}.fit h2 em{color:var(--brand)}.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.fit-grid article{background:color-mix(in srgb,var(--brand) 10%,var(--bg));border-top:4px solid var(--brand);padding:24px}.fit-grid article:last-child{background:color-mix(in srgb,var(--accent) 10%,var(--bg));border-color:var(--accent)}.fit-grid li{margin:16px 0}.fit-grid h3{font-size:20px}.information{display:grid;grid-template-columns:140px 1fr 220px;gap:32px;align-items:center;border-block:1px solid var(--ink);padding:64px 0}.information h2{font:400 36px Georgia,'Noto Serif TC',serif}.information>a{border-bottom:1px solid var(--brand);padding-bottom:12px}.faq{padding:112px 0;display:grid;grid-template-columns:1fr 1.5fr;gap:48px}.faq details{border-top:1px solid var(--line);padding:24px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{min-height:44px;font-size:18px;font-weight:700;cursor:pointer}.compass footer{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;border-top:1px solid var(--line);background:color-mix(in srgb,var(--brand) 10%,var(--bg));padding:48px}.compass footer strong{font:36px Georgia,'Noto Serif TC',serif}@media(max-width:950px){.header{flex-wrap:wrap;padding:20px 0}.hero-grid{gap:24px}.decision-row{grid-template-columns:64px 1fr;gap:16px}.decision-row>a{grid-column:2}.fit{display:block}.fit-grid{margin-top:32px}.information{grid-template-columns:1fr 2fr}.information>a{grid-column:2}.faq{gap:24px}}@media(max-width:700px){.hero{padding:40px 0 64px}.hero-grid{display:block}.compass h1{font-size:clamp(40px,10vw,60px)}.hero aside{border-left:0;border-top:1px solid var(--line);padding:24px 0 0;margin-top:32px}.decision{padding:48px 0}.decision-row h3{font-size:20px}.fit{padding:64px 0}.fit-grid{grid-template-columns:1fr}.information{display:block;padding:48px 0}.information>a{display:inline-block;margin-top:24px}.faq{display:block;padding:64px 0}.faq details:first-child{margin-top:32px}.compass footer{padding:32px 0}}
</style>